generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum DeadlineType {
  EXAM
  ASSIGNMENT
  OTHER
}

enum DeadlineStatus {
  PENDING
  COMPLETED
  MISSED
}

enum PomodoroMode {
  FOCUS
  SHORT_BREAK
  LONG_BREAK
}

enum PomodoroStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

// ==========================================
// USER
// ==========================================

model User {
  id       String  @id @default(cuid())
  clerkId  String  @unique
  name     String?
  email    String  @unique
  imageUrl String?

  profile StudentProfile?

  subjects         Subject[]
  deadlines        Deadline[]
  studySessions    StudySession[]
  pomodoroSessions PomodoroSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// STUDENT PROFILE
// ==========================================

model StudentProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  academicLevel String?
  institution   String?
  course        String?

  dailyStudyHours    Int?
  preferredStudyTime String?
  studyGoal          String?

  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// SUBJECT
// ==========================================

model Subject {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name               String
  description        String?
  color              String  @default("#A78BFA")
  targetHoursPerWeek Int?

  topics           Topic[]
  deadlines        Deadline[]
  studySessions    StudySession[]
  pomodoroSessions PomodoroSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// ==========================================
// TOPIC
// ==========================================

model Topic {
  id String @id @default(cuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  title            String
  description      String?
  status           TopicStatus @default(NOT_STARTED)
  priority         Priority    @default(MEDIUM)
  estimatedMinutes Int?
  order            Int         @default(0)
  completedAt      DateTime?

  deadlines        Deadline[]
  studySessions    StudySession[]
  pomodoroSessions PomodoroSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, title])
  @@index([subjectId])
  @@index([subjectId, status])
}

// ==========================================
// DEADLINE
// ==========================================

model Deadline {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  title       String
  description String?
  type        DeadlineType   @default(ASSIGNMENT)
  status      DeadlineStatus @default(PENDING)
  priority    Priority       @default(MEDIUM)

  dueAt      DateTime
  reminderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([subjectId])
  @@index([topicId])
}

// ==========================================
// STUDY SESSION
// ==========================================

model StudySession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  pomodoroSessions PomodoroSession[]

  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([subjectId])
  @@index([topicId])
}

// ==========================================
// POMODORO SESSION
// ==========================================

model PomodoroSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  studySessionId String?
  studySession   StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)

  mode   PomodoroMode   @default(FOCUS)
  status PomodoroStatus @default(RUNNING)

  startedAt DateTime  @default(now())
  endedAt   DateTime?
  pausedAt  DateTime?

  plannedDurationSeconds Int
  elapsedSeconds         Int     @default(0)
  completed              Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([subjectId])
  @@index([topicId])
}
